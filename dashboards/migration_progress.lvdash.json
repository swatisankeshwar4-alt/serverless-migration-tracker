{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT count(*) AS total_jobs,\n",
        "       count_if(i.compute_kind = 'SERVERLESS' OR s.status = 'DONE') AS on_serverless,\n",
        "       count_if(s.status = 'READY') AS ready,\n",
        "       count_if(s.status = 'BLOCKED') AS blocked,\n",
        "       count_if(s.status = 'APPROVED') AS approved,\n",
        "       round(avg(CASE WHEN i.compute_kind <> 'SERVERLESS' THEN s.readiness_score END), 1) AS avg_readiness\n",
        "FROM inventory_workloads i LEFT JOIN migration_status s ON s.workload_id = i.workload_id\n",
        "WHERE i.workload_type = 'JOB'\n"
      ]
    },
    {
      "name": "status",
      "displayName": "Jobs by status",
      "queryLines": [
        "SELECT coalesce(s.status, 'DISCOVERED') AS status, count(*) AS jobs\n",
        "FROM inventory_workloads i LEFT JOIN migration_status s ON s.workload_id = i.workload_id\n",
        "WHERE i.workload_type = 'JOB' GROUP BY 1\n"
      ]
    },
    {
      "name": "waves",
      "displayName": "Classic jobs by wave",
      "queryLines": [
        "SELECT concat('Wave ', s.wave) AS wave, count(*) AS jobs\n",
        "FROM inventory_workloads i JOIN migration_status s ON s.workload_id = i.workload_id\n",
        "WHERE i.workload_type = 'JOB' AND i.compute_kind <> 'SERVERLESS' AND s.wave IS NOT NULL GROUP BY 1\n"
      ]
    },
    {
      "name": "limits",
      "displayName": "Limitations found",
      "queryLines": [
        "SELECT limitation_id, count(DISTINCT workload_id) AS workloads_affected,\n",
        "       count_if(severity = 'BLOCKER') AS blockers, count_if(auto_fixable) AS auto_fixable\n",
        "FROM readiness_findings GROUP BY 1 ORDER BY cast(substr(limitation_id, 2) AS INT)\n"
      ]
    },
    {
      "name": "jobs",
      "displayName": "Job readiness",
      "queryLines": [
        "SELECT i.name, i.owner, i.compute_kind, i.task_count, s.readiness_score, s.status, s.wave,\n",
        "       (SELECT count(*) FROM readiness_findings f WHERE f.workload_id = i.workload_id AND f.severity = 'BLOCKER') AS blockers\n",
        "FROM inventory_workloads i LEFT JOIN migration_status s ON s.workload_id = i.workload_id\n",
        "WHERE i.workload_type = 'JOB' ORDER BY s.readiness_score\n"
      ]
    },
    {
      "name": "cost",
      "displayName": "Cost before vs after",
      "queryLines": [
        "SELECT job_name, team_tag, state, before_dbus, after_dbus, before_dbu_per_run, after_dbu_per_run,\n",
        "       dbu_per_run_change_pct, before_cost_usd, after_cost_usd, cost_per_run_change_pct\n",
        "FROM cost_summary ORDER BY job_name\n"
      ]
    }
  ],
