[
  {
    "job_id": 1001,
    "creator_user_name": "alice@example.com",
    "settings": {
      "name": "etl_daily_orders",
      "tags": {
        "team": "data-eng"
      },
      "schedule": {
        "quartz_cron_expression": "0 0 2 * * ?",
        "timezone_id": "UTC",
        "pause_status": "UNPAUSED"
      },
      "job_clusters": [
        {
          "job_cluster_key": "main",
          "new_cluster": {
            "spark_version": "15.4.x-scala2.12",
            "node_type_id": "i3.xlarge",
            "num_workers": 2
          }
        }
      ],
      "tasks": [
        {
          "task_key": "extract",
          "job_cluster_key": "main",
          "notebook_task": {
            "notebook_path": "/Shared/fixtures/etl_extract"
          }
        },
        {
          "task_key": "transform",
          "job_cluster_key": "main",
          "depends_on": [
            {
              "task_key": "extract"
            }
          ],
          "notebook_task": {
            "notebook_path": "/Shared/fixtures/etl_transform"
          }
        },
        {
          "task_key": "load",
          "job_cluster_key": "main",
          "depends_on": [
            {
              "task_key": "transform"
            }
          ],
          "notebook_task": {
            "notebook_path": "/Shared/fixtures/etl_load"
          }
        }
      ]
    }
  },
  {
    "job_id": 1002,
    "creator_user_name": "bob@example.com",
    "settings": {
      "name": "legacy_init_script_job",
      "tags": {
        "team": "finance"
      },
      "tasks": [
        {
          "task_key": "run",
          "notebook_task": {
            "notebook_path": "/Shared/fixtures/legacy_job"
          },
          "new_cluster": {
            "spark_version": "12.2.x-scala2.12",
            "node_type_id": "i3.xlarge",
            "num_workers": 1,
            "init_scripts": [
              {
                "s3": {
                  "destination": "s3://example-bucket/init/install.sh"
                }
              }
            ],
            "aws_attributes": {
              "instance_profile_arn": "arn:aws:iam::000000000000:instance-profile/example-profile"
            }
          }
        }
      ]
    }
  },
  {
    "job_id": 1003,
    "creator_user_name": "alice@example.com",
    "settings": {
      "name": "jar_and_egg_job",
      "tags": {
        "team": "data-eng"
      },
      "job_clusters": [
        {
          "job_cluster_key": "main",
          "new_cluster": {
            "spark_version": "14.3.x-scala2.12",
            "node_type_id": "i3.xlarge",
            "num_workers": 2
          }
        }
      ],
      "tasks": [
        {
          "task_key": "jar_step",
          "job_cluster_key": "main",
          "spark_jar_task": {
            "main_class_name": "com.example.Main"
          },
          "libraries": [
            {
              "jar": "dbfs:/FileStore/jars/app.jar"
            },
            {
              "maven": {
                "coordinates": "com.example:lib:1.0"
              }
            },
            {
              "egg": "dbfs:/FileStore/eggs/old.egg"
            }
          ]
        },
        {
          "task_key": "notebook_step",
          "job_cluster_key": "main",
          "depends_on": [
            {
              "task_key": "jar_step"
            }
          ],
          "notebook_task": {
            "notebook_path": "/Shared/fixtures/post_jar"
          }
        }
      ]
    }
  },
